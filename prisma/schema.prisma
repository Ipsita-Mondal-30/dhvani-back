generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model PDFDocument {
  id            String   @id @default(cuid())
  filename      String
  originalName  String
  fileSize      Int
  mimeType      String
  extractedText String?
  filePath      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pdf_documents")
}

model SOSLog {
  id        String   @id @default(cuid())
  userId    String?  // Optional user identification
  latitude  Float
  longitude Float
  status    String   // "SMS Sent", "Failed", "Permission Denied", etc.
  message   String?  // The emergency message sent
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sos_logs")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model CurrencyDetection {
  id           String   @id @default(cuid())
  userId       String?  // Optional user identification
  denomination Int      // The detected denomination (10, 20, 50, 100, 200, 500, 2000)
  confidence   Float?   // Confidence score from Vision API (0-1)
  detectedText String?  // Raw text detected by Vision API
  imageUri     String?  // Local image path/URI (optional)
  latitude     Float?   // Location where detection happened
  longitude    Float?   // Location where detection happened
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("currency_detections")
}